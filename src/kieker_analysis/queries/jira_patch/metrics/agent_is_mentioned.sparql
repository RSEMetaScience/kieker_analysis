PREFIX schema: <https://schema.org/>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
PREFIX github2prov: <http://purl.org/github2prov/>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX jira2prov: <http://purl.org/jira2prov/>

# number of times each agent is mentioned in issue descriptons or comments
SELECT ?agent (count(?event) as ?agent_mentioned)

WHERE {
 	{
    ?event rdf:type jira2prov:comment.
    ?event schema:mentions ?agent.
    }
    union
 	{
    ?event rdf:type jira2prov:issue.
    ?event schema:mentions ?agent.
     }
}
Group By ?agent